# ─── Base de datos ───────────────────────────────────────────────────────────
# URL pooled (pgbouncer) — usar en runtime (Prisma)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# URL directa — usar para migraciones (prisma migrate)
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].supabase.com:5432/postgres

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Settings → API → Project API Keys → anon / public
SUPABASE_ANON_KEY=eyJ...

# Settings → API → Project API Keys → service_role (solo backend, NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Settings → API → JWT Settings → JWT Secret  (usado por auth-middleware para validar tokens)
SUPABASE_JWT_SECRET=your-super-secret-jwt-token

# ─── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
