# ==============================================================================
#  Vendora — Variables de entorno (template sin secretos)
# ==============================================================================
#  Uso:
#   cp .env.example .env   (desarrollo local — NO commitear .env)
#
#  En Vercel (producción):
#   Cada microservicio es un proyecto independiente.
#   Configurar sus variables en Project Settings → Environment Variables.
#   Ver sección "Por proyecto Vercel" más abajo.
# ==============================================================================

# ─── Supabase (requerido por TODOS los backends) ───────────────────────────
# Settings → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Settings → API → service_role (NUNCA exponer en frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Settings → API → anon / public (solo tests de integración, no usado en runtime)
SUPABASE_ANON_KEY=eyJ...

# ─── Base de datos (solo desarrollo local / migraciones Prisma) ────────────
# No requerido por los microservicios en producción (usan Supabase SDK).
# Usado por packages/database para prisma migrate.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].supabase.com:5432/postgres

# ─── Frontend (solo vars públicas NEXT_PUBLIC_*) ───────────────────────────
# Configurar en el proyecto vendora-frontend en Vercel.
# En desarrollo local se ignoran (se usan los rewrites de next.config.ts).
NEXT_PUBLIC_AUTH_SERVICE_URL=https://vendora-api-auth-service.vercel.app
NEXT_PUBLIC_STORE_SERVICE_URL=https://vendora-api-store-service.vercel.app
NEXT_PUBLIC_PRODUCT_SERVICE_URL=https://vendora-api-product-service.vercel.app
NEXT_PUBLIC_ORDER_SERVICE_URL=https://vendora-api-order-service.vercel.app
NEXT_PUBLIC_ADMIN_BFF_URL=https://vendora-api-admin-bff.vercel.app

# ─── General ────────────────────────────────────────────────────────────────
NODE_ENV=development

# ==============================================================================
#  Configuración por proyecto en Vercel
# ==============================================================================
#
#  vendora-api-auth-service:
#    SUPABASE_URL
#    SUPABASE_SERVICE_ROLE_KEY
#
#  vendora-api-store-service:
#    SUPABASE_URL
#    SUPABASE_SERVICE_ROLE_KEY
#
#  vendora-api-product-service:
#    SUPABASE_URL
#    SUPABASE_SERVICE_ROLE_KEY
#
#  vendora-api-order-service:
#    SUPABASE_URL
#    SUPABASE_SERVICE_ROLE_KEY
#
#  vendora-api-admin-bff:
#    SUPABASE_URL
#    SUPABASE_SERVICE_ROLE_KEY
#
#  vendora-frontend:
#    NEXT_PUBLIC_AUTH_SERVICE_URL
#    NEXT_PUBLIC_STORE_SERVICE_URL
#    NEXT_PUBLIC_PRODUCT_SERVICE_URL
#    NEXT_PUBLIC_ORDER_SERVICE_URL
#    NEXT_PUBLIC_ADMIN_BFF_URL
#
#  IMPORTANTE:
#   - Las URLs NEXT_PUBLIC_* NO deben incluir sufijos (/auth, /stores, etc.).
#     El código en client.ts ya agrega las rutas.
#   - SUPABASE_SERVICE_ROLE_KEY nunca debe configurarse en el frontend.
# ==============================================================================
