generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MERCHANT
  CUSTOMER
  ADMIN
}

enum StoreStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String?
  role      UserRole @default(MERCHANT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores Store[]
}

model Store {
  id          String      @id @default(uuid())
  merchantId  String
  name        String
  slug        String      @unique
  description String?
  status      StoreStatus @default(TRIAL)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  merchant User @relation(fields: [merchantId], references: [id])
}
