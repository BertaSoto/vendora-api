# ─── API Base URL ─────────────────────────────────────────────────────────────
# En desarrollo: dejar vacío. next.config.ts redirige /api/* a localhost:300x
# En producción: NO se usa una sola URL base — el frontend llama directamente
# a cada microservicio desplegado. Ver next.config.ts para configurar rewrites
# de producción si se usa un API Gateway.
NEXT_PUBLIC_API_BASE_URL=

# ─── URLs de microservicios en producción (referencia) ────────────────────────
# Estas variables NO están en uso actualmente. Se muestran como referencia
# para cuando se implemente un cliente multi-endpoint en producción.
#
# NEXT_PUBLIC_AUTH_SERVICE_URL=https://vendora-api-auth-service.vercel.app
# NEXT_PUBLIC_PRODUCT_SERVICE_URL=https://vendora-api-product-service.vercel.app
# NEXT_PUBLIC_ORDER_SERVICE_URL=https://vendora-api-order-service.vercel.app
# NEXT_PUBLIC_STORE_SERVICE_URL=https://vendora-api-store-service.vercel.app
# NEXT_PUBLIC_BFF_URL=https://vendora-api-admin-bff.vercel.app
