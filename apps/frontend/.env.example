# Variables públicas del frontend (NEXT_PUBLIC_*)
# Las URLs apuntan a los microservicios desplegados en Vercel.
# En desarrollo local se ignoran — se usan los rewrites de next.config.ts.
#
# Para las variables de los backends (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY),
# ver el archivo .env.example en la raíz del monorepo.
#
# Configurar estas variables en Vercel → vendora-frontend → Settings → Environment Variables.

NEXT_PUBLIC_AUTH_SERVICE_URL=https://vendora-api-auth-service.vercel.app
NEXT_PUBLIC_STORE_SERVICE_URL=https://vendora-api-store-service.vercel.app
NEXT_PUBLIC_PRODUCT_SERVICE_URL=https://vendora-api-product-service.vercel.app
NEXT_PUBLIC_ORDER_SERVICE_URL=https://vendora-api-order-service.vercel.app
NEXT_PUBLIC_ADMIN_BFF_URL=https://vendora-api-admin-bff.vercel.app
